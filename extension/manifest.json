{
  "manifest_version": 3,
  "name": "FIFA Ticket Scout",
  "version": "2.6.4",
  "description": "Real-time price tracking for FIFA World Cup 2026 resale tickets. See every seat, every price, at a glance.",
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "*://*.tickets.fifa.com/*",
    "*://*.ticketmaster.com/*",
    "https://services.ticketmaster.com/*",
    "*://*.seatgeek.com/*",
    "*://*.stubhub.com/*",
    "*://*.evenue.net/*",
    "*://*.tickpick.com/*",
    "*://*.axs.com/*",
    "https://api.gumroad.com/*",
    "https://yaydpahqlqwesqdddgfi.supabase.co/*",
    "https://raw.githubusercontent.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.tickets.fifa.com/*"],
      "js": ["injected.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["*://*.tickets.fifa.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://*.ticketmaster.com/*"],
      "js": ["event-info.js", "ticketmaster-adapter.js", "injected.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["*://*.ticketmaster.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://*.seatgeek.com/*"],
      "js": ["event-info.js", "seatgeek-adapter.js", "injected.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["*://*.seatgeek.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://*.stubhub.com/*"],
      "js": ["event-info.js", "stubhub-adapter.js", "injected.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["*://*.stubhub.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://*.evenue.net/*"],
      "js": ["event-info.js", "evenue-adapter.js", "injected.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["*://*.evenue.net/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://*.tickpick.com/*"],
      "js": ["event-info.js", "tickpick-adapter.js", "injected.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["*://*.tickpick.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://*.axs.com/*"],
      "js": ["event-info.js", "axs-adapter.js", "injected.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["*://*.axs.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": []
}
